{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "yxanu/craft-cp-themes",
    "description": "Control Panel CSS themes and custom CSS for Craft CMS 6.",
    "type": "craft-plugin",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-alpha.20"
    },
    "autoload": {
        "psr-4": {
            "Local\\CpThemes\\": "src/"
        }
    },
    "extra": {
        "handle": "cp-themes",
        "name": "CP Themes",
        "developer": "Local",
        "documentationUrl": "",
        "class": "Local\\CpThemes\\CpThemes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true
        }
    }
}
